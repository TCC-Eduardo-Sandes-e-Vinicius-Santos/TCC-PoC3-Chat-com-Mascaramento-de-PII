# Parâmetros da derivação de chaves E2EE (crypto_aes.derive_shared_key).
# Copie para .env (cp .env.example .env) e substitua os valores.
#
# POC3_HKDF_SALT é SECRETO: 32 bytes aleatórios em base64, iguais em todos os
# clientes que conversam entre si e distribuídos fora do Kafka. Ele NÃO deve
# existir no host do broker. Gere com:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Trocar este valor torna ilegível todo o histórico já retido no Kafka.
POC3_HKDF_SALT=

# Rótulo de contexto/versão da chave. Não é secreto; serve para separar
# domínios e versionar a derivação (ex.: v1 -> v2 numa rotação).
POC3_HKDF_INFO=poc3-e2ee-key-v1
